#!ipxe

kernel http://{{ pxe_address }}/harvester/harvester-vmlinuz-{{ arch }}
initrd http://{{ pxe_address }}/harvester/harvester-initrd-{{ arch }}
imgargs harvester-vmlinuz-{{ arch }} initrd=harvester-initrd-{{ arch }} ip={{ mgmt_interface }}:dhcp net.ifnames=1 rd.cos.disable rd.live.debug=1 rd.noverifyssl root=live:http://{{ pxe_address }}/harvester/harvester-rootfs-{{ arch }}.squashfs console=tty1 harvester.install.automatic=true harvester.install.skipchecks=true harvester.install.config_url=http://{{ pxe_address }}/harvester/config-create.yaml
boot
