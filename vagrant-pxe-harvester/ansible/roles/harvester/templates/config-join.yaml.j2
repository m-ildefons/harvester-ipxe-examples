# example from https://github.com/harvester/ipxe-examples/blob/main/general/config-join.yaml

scheme_version: 1
server_url: https://{{ settings['harvester']['vip']['ip'] }}:443
token: {{ settings['harvester']['token'] }}
os:
  hostname: {{ settings['harvester']['cluster'][node_number | int]['name'] }}
  password: {{ settings['harvester']['global']['password'] }}
  ssh_authorized_keys:
{% for ssh_key in settings['harvester']['global']['ssh_authorized_keys'] %}
    - {{ ssh_key }}
{% endfor %}
  dns_nameservers:
{% for dns_server in settings['harvester']['global']['dns_servers'] %}
  - {{ dns_server }}
{% endfor %}
  ntp_servers:
{% if settings['harvester']['airgapped'] %}
{% for net in settings['networks'] %}
    - {{ net['subnet'][:-1] }}254
{% endfor %}
{% else %}
{% for ntp_server in settings['harvester']['global']['ntp_servers'] %}
    - {{ ntp_server }}
{% endfor %}
{% endif %}
{% if settings['harvester']['sftp'] %}
  sshd:
    sftp: {{ settings['harvester']['sftp'] }}
{% endif %}
  labels:
    topology.harvesterhci.io/hostname: {{ settings['harvester']['cluster'][node_number | int]['name'] }}
{% if settings['harvester']['cluster'][node_number | int]['labels'] is defined %}
{% for key, label in settings['harvester']['cluster'][node_number | int]['labels'].items() %}
    {{ key }}: {{ label }}
{% endfor %}
{% endif %}
install:
  mode: join
{% if settings['harvester']['cluster'][node_number | int]['role'] != 'default' %}
  role: {{ settings['harvester']['cluster'][node_number | int]['role'] }}
{% endif %}
  management_interface:
    interfaces:
      - name: {{ mgmt_interface }}
    method: dhcp
{% if settings['harvester']['cluster'][node_number | int]['root_disk'] is defined %}
  device: /dev/{{ settings['harvester']['cluster'][node_number | int]['root_disk'] }}
{% else %}
  device: /dev/{{ settings['harvester']['cluster'][node_number | int]['disks'][0]['name'] }}
{% endif %}
{% if settings['harvester']['cluster'][node_number | int]['data_disk'] is defined %}
  data_disk: /dev/{{ settings['harvester']['cluster'][node_number | int]['data_disk'] }}
{% endif %}
  iso_url: http://{{ hostvars['pxe_server']['ansible_eth0']['ipv4']['address'] }}/harvester/harvester-amd64.iso
#  tty: ttyS1,115200n8   # For machines without a VGA console
  tty: ttyS0
